{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offbook",
  "compatibility_date": "2026-07-01",
  "pages_build_output_dir": "dist",

  // The sync backend. ADR-0008.
  //
  // `database_id` is a plain identifier, not a secret — Cloudflare's own docs commit it.
  // Migrations: `npm run db:migrate` (remote) or `npm run db:migrate:local`. CI applies them
  // before every deploy, which needs Account -> D1 -> Edit on the API token.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "offbook",
      "database_id": "d6ef6a85-0931-480c-a74c-7a9d2492fb2d"
    }
  ]
}
